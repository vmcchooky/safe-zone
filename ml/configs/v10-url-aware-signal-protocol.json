    "cross_partition_group_overlap_max": 0
  },
  "partition_policy": {
    "hash": "sha256(seed|evaluation_group) modulo 10",
    "adaptation_train_buckets": [0, 1, 2, 3, 4, 5],
    "calibration_bucket": [6],
    "threshold_bucket": [7],
    "development_bucket": [8],
    "benign_final_bucket": [9],
    "maximum_rows": {
      "adaptation_train_per_label": 5000,
      "calibration_per_label": 1000,
      "threshold_per_label": 1000,
      "development_per_label": 1000,
      "final_benign": 500,
      "final_malicious": 250
    },
    "row_selection_order": "sha256(seed|label|normalized_url), normalized_url"
  },
  "url_feature_contract": {
    "hostname_features_excluded": true,
    "fragment_excluded": true,
    "userinfo_excluded": true,
    "normalized_text": "lowercase percent-preserving path plus sorted query parameter names and redacted value-shape tokens",
    "query_values": "replace characters with alpha/digit/symbol shape; never persist raw values in features",
    "handcrafted_features": [
      "path_length",
      "path_depth",
      "query_length",
      "query_parameter_count",
      "percent_escape_count",
      "digit_count",
      "digit_ratio",
      "special_character_count",
      "path_entropy",
      "suspicious_token_count",
      "brand_token_count",
      "has_ip_literal_in_path",
      "has_double_slash_in_path",
      "has_at_sign",
      "has_executable_extension",
      "redirect_count",
      "redirect_cross_host_count",
      "redirect_https_downgrade_count"
    ],
    "text_vectorizer": {
      "type": "TfidfVectorizer",
      "analyzer": "char",
      "ngram_range": [2, 5],
      "max_features": 8192,
      "min_df": 2,
      "sublinear_tf": true,
      "fit_scope": "adaptation train only"
    }
  },
  "model": {
    "pipeline": ["StandardScaler handcrafted", "TF-IDF", "SGDClassifier log_loss"],
    "alpha": 0.00001,
    "penalty": "l2",
    "max_iter": 1000,
    "class_weight": "balanced",
    "average": true,
    "random_state": 42,
    "calibration": "Platt calibration on group-disjoint calibration bucket",
    "threshold_rule": "smallest representable calibrated probability strictly above maximum benign probability on threshold bucket",
    "candidate_count": 1
  },
  "combined_decision": "domain_v3_positive OR (domain_v3_negative AND url_probability >= url_threshold)",
  "selection": {
    "inputs": ["adaptation_train", "calibration", "threshold", "development"],
    "forbidden_inputs": ["source_disjoint_final", "old_representative_packet", "old_targeted_benign_packet"],
    "eligibility_gates": {
      "threshold_accepted_benign_max": 0,
      "threshold_accepted_malicious_min": 5,
      "development_incremental_benign_false_positives_max": 0,
      "development_incremental_malicious_true_positives_min": 5
    },
    "no_rescue_policy": "do not alter source, split, features, alpha, vectorizer, calibration, threshold rule, or cohort after selection metrics"
  },
  "final_gates": {
    "source_disjoint_final_incremental_benign_false_positives_max": 0,
    "source_disjoint_final_incremental_malicious_true_positives_min": 3,
    "domain_only_probability_and_decision_parity": true,
    "url_parse_failure_preserves_domain_only_decision": true
  },
  "outputs": {
