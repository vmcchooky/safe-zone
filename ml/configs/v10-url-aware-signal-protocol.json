  "seed": 42,
  "objective": "add precision-preserving URL path and query signal for caller-supplied web analysis while keeping DNS and domain-only decisions unchanged",
  "product_contract": {
    "dns_behavior": "unchanged domain-only path",
    "api_url_context": "optional caller-supplied requested_url and redirect_chain",
    "server_side_fetch": false,
    "default_runtime_mode": "disabled",
    "allowed_schemes": ["http", "https"],
    "maximum_url_bytes": 4096,
    "maximum_redirects": 5,
    "reject_credentials": true,
    "require_requested_url_host_equals_canonical_domain": true,
    "raw_url_logging": false,
    "raw_query_logging": false,
    "failure_policy": "fail open to unchanged domain-only decision"
  },
  "control": {
