{
  "version": "1.0.0",
  "seed": 42,
  "contract_path": "contracts/domain_feature_contract.v1.json",
  "matrices_dir": "data/derived/matrices",
  "partitions_dir": "data/derived/partitions",
  "derived_dir": "data/derived",
  "models_dir": "data/derived/models",
  "lightgbm_params": {
    "objective": "binary",
    "metric": "binary_logloss",
    "boosting_type": "gbdt",
    "n_estimators": 1000,
    "learning_rate": 0.05,
    "num_leaves": 31,
    "max_depth": -1,
    "min_child_samples": 50,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "reg_alpha": 0.1,
    "reg_lambda": 1.0,
    "random_state": 42,
    "n_jobs": -1,
    "verbose": -1
  },
  "calibration": {
    "method": "platt",
    "clip_eps": 1e-15
  },
  "policy": {
    "policy_version": "1.0.0",
    "operating_mode": "enforce_v1",
    "action_on_block": "PROMOTE_SUSPICIOUS_TO_MALICIOUS",
    "action_on_pass": "ABSTAIN_KEEP_SUSPICIOUS",
    "allow_threshold_enabled": false
  }
}
