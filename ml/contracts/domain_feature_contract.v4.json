{
  "contract_version": "4.0.0",
  "supersedes": "domain_feature_contract.v3.json",
  "created_at": "2026-08-24T00:00:00Z",
  "dataset_target": "domain_dataset",
  "input_views": {
    "domain_ascii": "ASCII A-label canonical FQDN used by handcrafted features",
    "domain_unicode": "Unicode U-label canonical FQDN used by script and homoglyph features",
    "domain_without_public_suffix": "All canonical labels before the complete PSL public suffix; dots between subdomain and registrable labels are retained"
  },
  "handcrafted_feature_count": 22,
  "tfidf_feature_count": 512,
  "total_feature_count": 534,
  "handcrafted_feature_order": [
    "fqdn_length",
    "num_dots",
    "num_hyphens",
    "num_digits",
    "digit_ratio",
    "entropy",
    "max_consecutive_consonants",
    "main_label_length",
    "registrable_domain_length",
    "subdomain_depth",
    "token_count",
    "is_punycode",
    "has_mixed_script",
    "is_ip_like",
    "tld_risk_score",
    "phishing_keyword_count",
    "is_shared_hosting",
    "min_brand_levenshtein",
    "min_brand_keyboard_distance",
    "has_brand_homoglyph",
    "has_brand_in_main_label",
    "has_brand_in_subdomain"
  ],
  "tfidf_config": {
    "ngram_range": [2, 3],
    "max_features": 512,
    "analyzer": "char",
    "lowercase": true,
    "sublinear_tf": true,
    "norm": "l2",
    "oov_handling": "ignore_unknown_ngrams",
    "input_view": "domain_without_public_suffix"
  },
  "snapshot_policy": {
    "base_files": {
      "brands": "brands.v1.json",
      "keywords": "keywords.v1.json",
      "tld_risk": "tld_risk.v1.json",
      "shared_hosting": "shared_hosting.v1.json",
      "homoglyphs": "homoglyphs.v1.json",
      "keyboard_adjacency": "keyboard_adjacency.v1.json"
    },
    "keyword_extensions": ["xbet", "casino", "slot"],
    "shared_hosting_extensions": ["weebly.com", "weeblysite.com", "godaddysites.com"],
    "brand_extensions": [
      {
        "name": "spotify",
        "official_domain": "spotify.com",
        "alt_domains": ["spotifycdn.com"]
      }
    ],
    "tld_state_encoding": {
      "unknown": 0.0,
      "known_neutral": 0.5,
      "risky": 1.0
    },
    "provenance_refs": [
      "Mozilla PSL checksum-pinned snapshot for known versus unknown suffix state",
      "local checksum-pinned partition label audit 2026-08-24"
    ]
  },
  "compatibility": {
    "feature_dimensions_unchanged_from_v3": true,
    "v4_requires_exact_snapshot_policy": true,
    "tld_risk_score_semantics": "unknown=0.0,known_neutral=0.5,risky=1.0"
  },
  "training_invariants": {
    "fit_tfidf_on": "train_split_only",
    "group_key": "registrable_domain_or_shared_hosting_tenant",
    "frozen_challenge_excluded_from_all_partitions": true,
    "frozen_evaluation_excluded_from_all_partitions": true,
    "time_forward_holdout_excluded_from_model_selection": true,
    "hard_positive_label_kind": "verified_online_time_forward",
    "hard_positive_weight_must_be_at_least_one_and_at_most_ten": true
  }
}
