# Normalize text files to LF in the repo so the working tree does not show
# phantom CRLF-only modifications (found 452 files, 2026-09-20). Git
# auto-detects binaries (NUL byte) and leaves them untouched.
* text=auto
# Go sources must always be LF in the working tree so `gofmt -l` stays quiet
# regardless of core.autocrlf (see ADR 0006 layout conventions / repo hygiene).
*.go text eol=lf
# Shell scripts must stay LF: a CRLF checkout breaks `sh`/`dash` on Linux
# (e.g. `set: Illegal option -` after scp to the VPS). Found 2026-09-20.
*.sh text eol=lf
# Python sources follow the same rule as Go: with core.autocrlf=true on
# Windows they otherwise show up as a phantom whole-tree diff after any edit,
# and a CRLF shebang would break on Linux. Found 2026-09-27.
*.py text eol=lf
# Ensure .gitignore always uses LF so Windows line endings do not break pattern parsing.
.gitignore text eol=lf

# Env templates, Compose files, and the Dockerfile must stay LF. A CRLF env
# file copied to a Linux host can leave a trailing \r in values (hostnames,
# URLs, secrets), and CRLF in a Dockerfile breaks line continuations.
*.example text eol=lf
docker-compose*.yml text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf

# UI sources must stay LF for the same reason as Go and shell: `npm run check`
# runs Prettier with the default endOfLine=lf, and the Docker build runs that
# check on the build context. A Windows checkout with core.autocrlf=true
# otherwise fails the image build even though CI (Linux) is green.
# Found 2026-10-24 while validating the VPS candidate.
ui/** text=auto eol=lf

# Exclude CI, internal agent metadata, and local scanners from GitHub Release archive downloads
.github export-ignore
.agents export-ignore
.gitleaks.toml export-ignore
.golangci.yml export-ignore

