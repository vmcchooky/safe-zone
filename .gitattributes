# Normalize text files to LF in the repo so the working tree does not show
# phantom CRLF-only modifications (found 452 files, 2026-09-20). Git
# auto-detects binaries (NUL byte) and leaves them untouched.
* text=auto
# Go sources must always be LF in the working tree so `gofmt -l` stays quiet
# regardless of core.autocrlf (see ADR 0006 layout conventions / repo hygiene).
*.go text eol=lf
# Shell scripts must stay LF: a CRLF checkout breaks `sh`/`dash` on Linux
# (e.g. `set: Illegal option -` after scp to the VPS). Found 2026-09-20.
*.sh text eol=lf
