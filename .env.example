# Required. core-api refuses to start when this is empty or unsupported.
# Supported values: local, test, development, production (alias: prod).
# Only local/test may generate temporary local-only admin credentials;
# development/production fail fast on missing or weak secrets.
# SAFE_ZONE_ADMIN_PASSWORD must be 12-72 BYTES (bcrypt input limit; multibyte
# characters count per byte, not per rune).
SAFE_ZONE_ENV=local
SAFE_ZONE_DEPLOYMENT_TIER=budget-vps
SAFE_ZONE_DOCKER_LOG_MAX_SIZE=10m
SAFE_ZONE_DOCKER_LOG_MAX_FILE=5

# --- Production Edge (Caddy + DuckDNS) ---
SAFE_ZONE_PUBLIC_HOST=safezone.example.com
SAFE_ZONE_CADDY_EMAIL=admin@example.com
SAFE_ZONE_DUCKDNS_DOMAIN=
SAFE_ZONE_DUCKDNS_TOKEN=
SAFE_ZONE_DUCKDNS_TOKEN_FILE=
# For local files and Compose containers, prefer paths under ./ops/secrets
# and set either VAR or VAR_FILE, not both.
SAFE_ZONE_SECRET_FILE_ROOT=./ops/secrets
SAFE_ZONE_FEED_FILE_ROOT=./data
SAFE_ZONE_CONFIG_FILE_ROOT=./data

SAFE_ZONE_HEALTHCHECK_PORT=8080
SAFE_ZONE_HEALTHCHECK_PATH=/healthz

SAFE_ZONE_CORE_API_ADDR=:8080
SAFE_ZONE_DNS_RESOLVER_ADDR=:8081
SAFE_ZONE_SHUTDOWN_TIMEOUT_MS=10000

SAFE_ZONE_REDIS_ADDR=redis:6379
SAFE_ZONE_REDIS_PASSWORD=
SAFE_ZONE_REDIS_PASSWORD_FILE=
SAFE_ZONE_REDIS_DB=0
SAFE_ZONE_REDIS_TIMEOUT_MS=250
SAFE_ZONE_REDIS_MAXMEMORY=256mb
# Keep non-expiring threat-feed/status keys out of the eviction pool. Do not
# use allkeys-* in production unless threat feeds move to a separate Redis.
SAFE_ZONE_REDIS_MAXMEMORY_POLICY=volatile-lru

SAFE_ZONE_THREAT_FEED_KEY=safe-zone:threat:feed
SAFE_ZONE_THREAT_FEED_SOURCE=
SAFE_ZONE_FEED_SYNC_TIMEOUT_MS=30000
SAFE_ZONE_FEED_MAX_BYTES=52428800
SAFE_ZONE_FEED_SYNC_INTERVAL_SECONDS=86400
# Expiry window scored into every threat-feed member (days). Both the feed
# sync tools and the OSINT background promotion use this value; a promoted
# domain stops matching once its score is in the past.
SAFE_ZONE_FEED_TTL_DAYS=14
# Shortened expiry, in days, for members under a recycled-label root
# (dynamic DNS, free bulk hosting, ephemeral tunnels, IPFS gateways). Such a
# label returns to the pool when the campaign ends, so a stale entry can
# outlive the attacker and catch whoever claims the name next. Sync re-scores
# every member on every run, so a member that is still listed keeps its expiry
# pushed forward: this only changes how fast an entry clears after it drops out
# of its source. 0 disables the split and everything expires on the TTL above.
# Must be 0 or at least 2, and must exceed SAFE_ZONE_FEED_SYNC_INTERVAL_SECONDS,
# otherwise startup is refused rather than silently under-blocking.
SAFE_ZONE_FEED_CHURN_TTL_DAYS=0
SAFE_ZONE_FEED_DRIFT_INVALID_RATIO=0.20
SAFE_ZONE_FEED_DRIFT_MIN_INVALID=25
SAFE_ZONE_FEED_CACHE_INVALIDATION_MIN_WRITES=1
# --- AI Provider Configuration ---
# Options: none (disabled), gemini (free cloud), ollama (local offline), hybrid (ollama with gemini fallback)
# Note: "gemini" is perfect for low-RAM VPS (< 2GB RAM), while "ollama" is ideal for full offline privacy.
SAFE_ZONE_AI_PROVIDER=gemini

# Google Gemini API Settings (Cloud AI)
SAFE_ZONE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SAFE_ZONE_GEMINI_API_KEY=
SAFE_ZONE_GEMINI_API_KEY_FILE=
SAFE_ZONE_GEMINI_MODEL=gemini-2.5-flash-lite
SAFE_ZONE_GEMINI_TIMEOUT_MS=3000

# Local Ollama Settings (Offline AI)
SAFE_ZONE_OLLAMA_BASE_URL=http://localhost:11434
SAFE_ZONE_OLLAMA_MODEL=gemma2:2b
SAFE_ZONE_OLLAMA_TIMEOUT_MS=5000

SAFE_ZONE_CACHE_TTL_ALLOWED_SECONDS=10800
SAFE_ZONE_CACHE_TTL_SUSPICIOUS_SECONDS=3600
SAFE_ZONE_CACHE_TTL_BLOCKED_SECONDS=21600

SAFE_ZONE_UPSTREAM_DOH_URL=https://cloudflare-dns.com/dns-query
SAFE_ZONE_UPSTREAM_DOH_TIMEOUT_MS=3000
SAFE_ZONE_BLOCK_PAGE_IP=127.0.0.1
# In production, set SAFE_ZONE_BLOCK_PAGE_IP to the public IPv4 that serves the
# Safe Zone block page. Keep 127.0.0.1 for local development only.
SAFE_ZONE_DNS_BLOCK_TTL_SECONDS=60
SAFE_ZONE_BLOCK_PAGE_SUPPORT_EMAIL=
SAFE_ZONE_ENRICH_ENABLED=true
SAFE_ZONE_ENRICH_TIMEOUT_MS=3000
SAFE_ZONE_WHOIS_CACHE_TTL_DAYS=7

# --- OSINT Public Evidence Lookup ---
# Uses configured public warning/feed pages first; optional paid API keys can be
# wired later without changing /v1/analyze.
# SAFE_ZONE_OSINT_MODE is the only supported value: the API performs on-demand
# lookups while the background agent task audits recent candidates. Any other
# value fails startup. Promotion expiry follows SAFE_ZONE_FEED_TTL_DAYS.
SAFE_ZONE_OSINT_ENABLED=true
SAFE_ZONE_OSINT_MODE=background_on_demand
SAFE_ZONE_OSINT_TIMEOUT_MS=2000
SAFE_ZONE_OSINT_CACHE_TTL_SECONDS=21600
SAFE_ZONE_OSINT_TRUSTED_DOMAINS=gov.vn,bocongan.gov.vn,mps.gov.vn,baochinhphu.vn,thanhnien.vn,tuoitre.vn,vnexpress.net,vietnamnet.vn,nhandan.vn,vtv.vn,vov.vn
# Comma-separated URLs for official/free warning pages, RSS feeds, or curated
# public alert pages. Do not use Google HTML scraping; use official APIs if added.
SAFE_ZONE_OSINT_SOURCES=

SAFE_ZONE_DASHBOARD_RECENT_LIMIT=25

# --- Custom Domain ML (Phase 5 shadow/canary) ---
# Keep disabled until an approved bundle has been provisioned and reviewed.
SAFE_ZONE_ML_MODE=disabled
# Host path mounted read-only into both core-api and dns-resolver.
SAFE_ZONE_ML_BUNDLE_HOST_DIR=./deploy/model-bundle/current
SAFE_ZONE_ML_BUNDLE_DIR=/app/models/safe-zone/current
SAFE_ZONE_ML_REQUIRED=false
SAFE_ZONE_ML_BLOCK_THRESHOLD=
# Stable normalized-domain cohort. Required before ML_MODE=enforce.
SAFE_ZONE_ML_CANARY_PERCENT=0
SAFE_ZONE_ML_CANARY_SEED=

# --- URL-aware ML specialist (core API POST only) ---
# Offline-eligible candidate; keep disabled until a separately approved shadow window.
# Only disabled/shadow are accepted. Enforce is intentionally unsupported.
SAFE_ZONE_URL_ML_MODE=disabled
SAFE_ZONE_URL_ML_BUNDLE_DIR=/app/models/safe-zone/url-v1
SAFE_ZONE_URL_ML_REQUIRED=false
# Full shadow by default. For a stable subset, set 1-99 and provide a seed.
SAFE_ZONE_URL_ML_SHADOW_PERCENT=100
SAFE_ZONE_URL_ML_SHADOW_SEED=
# Optional frozen operational drift baseline (staging shadow traffic only;
# never a production baseline until an external window is frozen).
SAFE_ZONE_URL_ML_BASELINE_PATH=

# Durable URL ML label feedback. Without a secret the feedback buffer stays
# in-memory (ephemeral). With a secret, fingerprints become stable HMACs and
# labels persist in bounded SQLite rows (TTL + row cap + dedupe + one-label
# anti-replay). Inject the secret via env or *_FILE under the secret root.
SAFE_ZONE_URL_ML_FEEDBACK_SECRET=
# SAFE_ZONE_URL_ML_FEEDBACK_SECRET_FILE=ops/secrets/url_feedback_hmac
SAFE_ZONE_URL_ML_FEEDBACK_KEY_VERSION=1
# One-step rotation: keep the previous secret/version so pre-rotation events
# stay correlatable while they age out.
SAFE_ZONE_URL_ML_FEEDBACK_PREVIOUS_SECRET=
SAFE_ZONE_URL_ML_FEEDBACK_PREVIOUS_KEY_VERSION=
SAFE_ZONE_URL_ML_FEEDBACK_RETENTION_HOURS=168
SAFE_ZONE_URL_ML_FEEDBACK_MAX_ROWS=65536

# --- SQLite (Telemetry & Local Overrides) ---
SAFE_ZONE_SQLITE_PATH=/run/safe-zone/data/safe-zone.db
SAFE_ZONE_TELEMETRY_RETENTION_DAYS=30
# Empty selects 100% in base/dev and 5% in docker-compose.production.yml.
# Under high sustained traffic or disk constraints, override explicitly to 1 (1%).
SAFE_ZONE_TELEMETRY_WRITE_PERCENT=

# --- Analysis Config Reload (multi-node hot reload) ---
# Keep enabled for shared SQLite + Redis deployments. Single-node setups without
# Redis still keep working; Pub/Sub simply stays inactive.
SAFE_ZONE_CONFIG_RELOAD_ENABLED=true
SAFE_ZONE_CONFIG_RELOAD_CHANNEL=safe-zone:config:analysis:updated
SAFE_ZONE_CONFIG_RELOAD_POLL_SECONDS=30

# --- Rate Limiting ---
SAFE_ZONE_RATELIMIT_ENABLED=true
SAFE_ZONE_RATELIMIT_ANALYZE_RPM=10
SAFE_ZONE_RATELIMIT_ANALYZE_BURST=5
SAFE_ZONE_RATELIMIT_OVERRIDE_RPM=20
SAFE_ZONE_RATELIMIT_OVERRIDE_BURST=5
SAFE_ZONE_RATELIMIT_TELEMETRY_RPM=30
SAFE_ZONE_RATELIMIT_TELEMETRY_BURST=10
SAFE_ZONE_RATELIMIT_FEEDBACK_RPM=30
SAFE_ZONE_RATELIMIT_FEEDBACK_BURST=10
SAFE_ZONE_RATELIMIT_DOH_RPM=100
SAFE_ZONE_RATELIMIT_DOH_BURST=20
SAFE_ZONE_RATELIMIT_DEFAULT_RPM=60
SAFE_ZONE_RATELIMIT_DEFAULT_BURST=15
# Hard cap on distinct rate-limit keys tracked per limiter, so a client-IP
# flood cannot grow the map without bound. There are 8 limiters in core-api
# plus 3 in dns-resolver.
#
# Trimming is an intrusive LRU split into two lists: keys holding a token, and
# keys currently throttled. A throttled key is the last thing eviction spends,
# so a client being rate limited does not lose its bucket and get a fresh burst
# when unrelated traffic arrives.
#
# Cost, measured: a tracked key is about 179 bytes with the LRU links, against
# ~83 for a plain map entry, so at full capacity the default is roughly 94 MiB
# of key state across all 11 limiters. The cap is a memory ceiling, not a
# brute-force defence.
#
# Two things to know before tuning it low:
#   - The trim is 90% of the cap, so a very small cap (say 10) rewrites nearly
#     the whole map on every new key, which resets rate limits for live clients.
#     Keep it in the thousands unless you are measuring.
#   - A client arriving from a routed IPv6 prefix can present 2^64 distinct
#     addresses, so "reaching 50k keys is hard" does not hold for an
#     IPv6-only client. The login limiter's rate and the credential policy are
#     the defences; this cap only bounds memory.
SAFE_ZONE_RATELIMIT_MAX_KEYS=50000

# Peers allowed to set X-Forwarded-For / X-Real-IP, as a comma-separated CIDR
# list. A client IP is only read from those headers when the request's socket
# address falls inside this list; otherwise the socket address is used.
#
# List PROXY ADDRESSES ONLY, never a range that also contains clients. Any
# client inside a listed range looks exactly like a proxy: the parser skips it
# as a proxy hop and then honours whatever the client put to its left. Listing
# all of RFC1918 is what made that possible, so the shipped defaults do not.
#
# The binary default is loopback-only. The Compose stack adds 172.16/12, which
# contains every default Docker address pool, because Caddy reaches the
# services over the bridge network. If you set custom
# default-address-pools, add the bridge subnet your Caddy container actually
# receives; otherwise every client will be keyed by Caddy's own address and
# the per-client limits will stop working.
#
# An unparsable entry fails closed to loopback-only and logs a warning. A very
# broad entry (prefix <= /8 for IPv4) is accepted but warned about, because it
# re-creates the original spoofing hole.
SAFE_ZONE_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# --- Whitelist import safety floor ---
# The whitelist is a safety valve: a listed domain is reported SAFE and never
# reaches the threat feed, lexical scoring, ML, AI, OSINT or group enforcement.
# Replacing it with an empty or collapsed set is therefore a total loss of
# protection, not a partial degradation — and an empty download, a captive
# portal page or a truncated body all produce exactly that.
#
# An import is refused (and the live set left untouched) when it would drop
# below either floor. Both apply only when a previous set exists: a first import
# of any size removes no protection, so a small hand-written whitelist stays
# installable.
#
# Set either to 0 to disable that check.
#
# TO CLEAR A POPULATED WHITELIST: there is no single-import escape, because
# "replace with nothing" and "source is broken" look identical. Either set
# SAFE_ZONE_WHITELIST_MIN_ENTRIES=0 for the import that empties it, or shrink
# in steps that each clear the relative floor (for example 1000 -> 600 -> 400).
SAFE_ZONE_WHITELIST_MIN_ENTRIES=100
SAFE_ZONE_WHITELIST_MIN_PERCENT=50

# There is no lookup timeout knob, and that is deliberate. The whitelist index is
# held entirely in RAM, so a DNS query never waits on the database: it cannot be
# queued behind an operator reload, and it cannot give up and report a
# whitelisted domain as unlisted. SQLite is the durable copy that the index is
# rebuilt from on load; it is not on the request path.
#
# The cost is memory: measured at 65 bytes per entry, so about 62 MiB for a
# million domains, of which the Bloom filter is 1.1 MiB. Watch
# whitelist.exact_index_entries in the agent metrics when sizing a source.

# --- Threat feed ingest limits ---
# The feed parser and the admission planner both retain one entry per distinct
# domain. A hostile or broken source can name millions, which on a small VPS is
# hundreds of megabytes. Both structures are capped at 2000000 distinct
# domains — well above a real feed (URLhaus is O(10^4), OpenPhish O(10^5)) and
# far below what would exhaust the host. Measured on a synthetic 3,000,000-line
# feed: peak heap 266MB capped against 492MB uncapped, with every indicator
# still delivered.
#
# Past the cap the parser classifies later distinct domains as duplicates (no
# IOC is dropped) and the planner declines to admit them, which is the safe
# direction. Both counts are reported: truncated_domains in parse_stats, and
# unclassifiable_domains in the admission plan.
SAFE_ZONE_FEED_MAX_DISTINCT_DOMAINS=2000000

# --- Session cookie transport ---
# Secure flag on the admin session cookie. Unset it to follow the connection:
# Secure when TLS is direct, or when a peer inside SAFE_ZONE_TRUSTED_PROXIES
# reports X-Forwarded-Proto: https. Set it to true to require Secure always,
# which is the default under SAFE_ZONE_ENV=production. A client-supplied
# forwarded header from an untrusted peer is never able to set this flag.
SAFE_ZONE_FORCE_SECURE_COOKIES=

# --- Outbound Fetch Guard ---
# Every outbound fetch (threat feeds, OSINT, WHOIS/TLS enrichment, alert
# webhooks) goes through internal/netguard, which resolves the destination and
# refuses loopback, private, link-local (including 169.254.169.254), CGNAT,
# multicast and the non-routable IPv4 ranges. This guards against SSRF and
# against a poisoned feed or DNS record pointing the resolver at internal
# services.
#
# The guarded transport deliberately IGNORES HTTP_PROXY / HTTPS_PROXY /
# ALL_PROXY. With a proxy in play the connection goes to the proxy, so the
# address that gets validated is the proxy's and never the destination — which
# makes the guard silently useless. Container deployments routinely have these
# variables set.
#
# Set this to true only if the host genuinely cannot reach the internet without
# a proxy. The guard then no longer protects the destination. It is surfaced as
# outbound_proxy_enabled on /v1/status under decision_pipeline, so alert on that
# field rather than assuming the guard is active. Leave it unset otherwise.
SAFE_ZONE_OUTBOUND_PROXY=

# --- AI Agent Workflow ---
SAFE_ZONE_AGENT_ENABLED=false
SAFE_ZONE_AGENT_AUDIT_INTERVAL_SECONDS=3600
SAFE_ZONE_AGENT_AUDIT_TIMEOUT_SECONDS=300
SAFE_ZONE_AGENT_AUDIT_MIN_OCCURRENCES=3
SAFE_ZONE_AGENT_AUDIT_MAX_PER_CYCLE=50
SAFE_ZONE_AGENT_AUDIT_CONFIDENCE_THRESHOLD=0.7
# Length of each frozen audit window; cycles paginate inside a window until
# every suspicious domain has been processed (no loss across restarts).
SAFE_ZONE_AGENT_AUDIT_LOOKBACK_SECONDS=86400
SAFE_ZONE_AGENT_ENRICH_TIMEOUT_SECONDS=5
SAFE_ZONE_AGENT_FEED_PRESET=
# Set SAFE_ZONE_AGENT_FEED_PRESET=production-free for the minimal global preset.
# Set SAFE_ZONE_AGENT_FEED_PRESET=production-vn for the expanded phishing/scam preset:
# - https://urlhaus.abuse.ch/downloads/csv_recent/
# - https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt
# - https://raw.githubusercontent.com/phishdestroy/destroylist/main/rootlist/formats/primary_active/domains.txt
# - https://raw.githubusercontent.com/Phishing-Database/Phishing.Database/master/phishing-domains-ACTIVE.txt
# REScure currently shows a temporary-closure page as of 2026-05-21, so it is not part
# of the first-class preset anymore.
SAFE_ZONE_AGENT_FEED_SOURCES=
SAFE_ZONE_AGENT_FEED_INTERVAL_SECONDS=86400
SAFE_ZONE_AGENT_FEED_TIMEOUT_SECONDS=120
SAFE_ZONE_AGENT_FEED_STALE_AFTER_SECONDS=129600
SAFE_ZONE_AGENT_FEED_DRIFT_INVALID_RATIO=0.20
SAFE_ZONE_AGENT_FEED_DRIFT_MIN_INVALID=25
SAFE_ZONE_AGENT_FEED_CACHE_INVALIDATION_MIN_WRITES=1
# Shadow mode reports path-scoped URL-host admission without changing the block set.
SAFE_ZONE_AGENT_FEED_ADMISSION_MODE=corroborated-url-host-shadow
SAFE_ZONE_AGENT_OSINT_INTERVAL_SECONDS=3600
SAFE_ZONE_AGENT_OSINT_TIMEOUT_SECONDS=120
SAFE_ZONE_AGENT_OSINT_MAX_PER_CYCLE=50
SAFE_ZONE_AGENT_OSINT_LOOKBACK_SECONDS=86400
SAFE_ZONE_AGENT_WEBHOOK_URL=
SAFE_ZONE_AGENT_WEBHOOK_URL_FILE=
SAFE_ZONE_AGENT_ALERT_INTERVAL_SECONDS=900
SAFE_ZONE_AGENT_ALERT_TIMEOUT_SECONDS=30
SAFE_ZONE_AGENT_ALERT_MIN_EVENTS=1

# --- Whitelist Auto-Update ---
SAFE_ZONE_AGENT_WHITELIST_ENABLED=true
SAFE_ZONE_AGENT_WHITELIST_INTERVAL_SECONDS=604800
SAFE_ZONE_AGENT_WHITELIST_TIMEOUT_SECONDS=600
SAFE_ZONE_AGENT_WHITELIST_SOURCE_URL=https://tranco-list.eu/download/L/1000000

# --- DNS-over-TLS (DoT) Configurations ---
SAFE_ZONE_DNS_DOT_ENABLED=true
SAFE_ZONE_DNS_DOT_CONTAINER_PORT=8533
SAFE_ZONE_DNS_DOT_PUBLISHED_PORT=853
SAFE_ZONE_DNS_DOT_DEV_PUBLISHED_PORT=1853
SAFE_ZONE_DNS_DOT_CERTS_DIR=./ops/certs/dot
SAFE_ZONE_DNS_DOT_CERT_FILE=
SAFE_ZONE_DNS_DOT_KEY_FILE=
SAFE_ZONE_RATELIMIT_DOT_RPM=100
SAFE_ZONE_RATELIMIT_DOT_BURST=20

# --- Admin Security ---
# 12-72 BYTES (bcrypt input limit; multibyte characters count per byte).
SAFE_ZONE_ADMIN_PASSWORD=
SAFE_ZONE_ADMIN_PASSWORD_FILE=
SAFE_ZONE_ADMIN_API_KEY=
SAFE_ZONE_ADMIN_API_KEY_FILE=
# Login name for the administrator account; defaults to admin.
SAFE_ZONE_ADMIN_USERNAME=admin

# --- Advanced Alert Settings ---
# Telegram Configuration
SAFE_ZONE_ALERT_TELEGRAM_ENABLED=false
SAFE_ZONE_ALERT_TELEGRAM_TOKEN=your_bot_token_here
SAFE_ZONE_ALERT_TELEGRAM_TOKEN_FILE=
SAFE_ZONE_ALERT_TELEGRAM_CHAT_ID=your_chat_id_here

# Slack Configuration
SAFE_ZONE_ALERT_SLACK_ENABLED=false
SAFE_ZONE_ALERT_SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SAFE_ZONE_ALERT_SLACK_WEBHOOK_URL_FILE=

# Email Configuration
SAFE_ZONE_ALERT_EMAIL_ENABLED=false
SAFE_ZONE_ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
SAFE_ZONE_ALERT_EMAIL_SMTP_PORT=587
SAFE_ZONE_ALERT_EMAIL_USERNAME=
SAFE_ZONE_ALERT_EMAIL_FROM=sender@gmail.com
SAFE_ZONE_ALERT_EMAIL_PASSWORD=your_app_password
SAFE_ZONE_ALERT_EMAIL_PASSWORD_FILE=
SAFE_ZONE_ALERT_EMAIL_TO=admin@example.com

# --- Offsite Backups (rclone) ---
SAFE_ZONE_RCLONE_REMOTE=
SAFE_ZONE_RCLONE_DEST=safe-zone-backups
SAFE_ZONE_BACKUP_ENCRYPT=false
SAFE_ZONE_BACKUP_GPG_RECIPIENT=
SAFE_ZONE_BACKUP_GPG_PASSPHRASE=
SAFE_ZONE_BACKUP_GPG_PASSPHRASE_FILE=
SAFE_ZONE_BACKUP_KEEP_PLAINTEXT=false

# --- DNS Upstream Resiliency ---
SAFE_ZONE_UPSTREAM_DOH_URLS=https://cloudflare-dns.com/dns-query,https://dns.google/dns-query,https://dns.quad9.net/dns-query,https://dns.adguard-dns.com/dns-query
SAFE_ZONE_UPSTREAM_DOH_TIMEOUT_MS=3000
SAFE_ZONE_UPSTREAM_DOH_PROBE_INTERVAL_MS=30000

# --- DNS Blocking Strategy ---
# Options:
# - sinkhole: Resolve A/AAAA to SAFE_ZONE_BLOCK_PAGE_IP (allows HTTP block page, but causes HTTPS SSL warnings)
# - nxdomain: Return NXDOMAIN error (silent blocking, avoids HTTPS SSL warnings)
# - refused: Return REFUSED DNS error
# - nullip: Resolve A to 0.0.0.0 and AAAA to :: (instant fails, avoids HTTPS SSL warnings)
SAFE_ZONE_DNS_BLOCK_STRATEGY=sinkhole

# --- Adblock (Domain Trie) ---
SAFE_ZONE_ADBLOCK_ENABLED=true
SAFE_ZONE_ADBLOCK_SOURCES=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
SAFE_ZONE_ADBLOCK_INTERVAL_SECONDS=43200
# Default scope for host-list entries without their own wildcard marker:
# - suffix (default, PR2 rollout): entry also blocks all subdomains (pre-PR2 behavior).
# - exact: entry blocks only the listed hostname (PR3 rollout target).
# Invalid values log one warning and fall back to suffix; startup never fails.
SAFE_ZONE_ADBLOCK_MATCH_MODE=suffix
# Optional per-source ingestion policies. Keys are canonicalized like URLs
# (scheme and host lowercased), so a key matches a source in
# SAFE_ZONE_ADBLOCK_SOURCES regardless of how its case is spelled. Missing
# fields use the global defaults; invalid category falls back to unknown,
# invalid scope to the global match mode (both with a one-time warning).
# Wildcard entries (*.example.com) are always suffix rules.
# Categories: ads, tracking, telemetry, nuisance, unknown.
#
# This value is the process default. A value persisted in the store under the
# adblock_source_policies key takes precedence and is re-read every 30 seconds by
# both core-api and dns-resolver, so a change reaches both without a restart. The
# effective set is reported as adblock.source_policies_fingerprint in each service
# status; compare the two digests to confirm the services agree.
#
# Write it at runtime from the operator dashboard (Settings → Ad blocking →
# Per-source policies, or `POST /v1/settings` with
# `{"adblock_source_policies_json": "..."}`). That path validates strictly: an
# unknown category or scope is a 400 rather than a silent fallback, so what you
# save is what runs. This environment variable stays lenient on purpose — a typo
# in a startup value must not stop DNS from resolving. An empty document saved
# through the API clears the override and falls back to this variable.
# SAFE_ZONE_ADBLOCK_SOURCE_POLICIES_JSON={"https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts":{"category":"unknown","scope":"exact"}}
# Scoped content exceptions (PR3A): a JSON file that suppresses individual
# adblock matches so verified false positives fall through to the full
# security pipeline instead of the content block. Empty/unset disables the
# feature. The path must stay inside SAFE_ZONE_FEED_FILE_ROOT. Invalid,
# missing or oversized files publish an empty set at startup and keep the last
# valid snapshot on runtime reload; a valid empty file clears all exceptions.
# Limits: 256 KiB, 1024 entries. Reloads every 30s on the adblock config tick.
# In production the exception file path is pinned at startup; changing or
# unsetting the path requires a restart, while file contents reload every 30s.
# SAFE_ZONE_ADBLOCK_EXCEPTIONS_FILE=adblock_exceptions.json
# Shadow exact/suffix observation (PR3B-lite): counts what a prospective
# global suffix-to-exact flip would do to adblock hits, without changing
# enforcement, decisions, request telemetry or answers; only bounded status
# aggregates are updated. Startup-only flag, default disabled. Only active
# under separated semantics while the global match mode is still suffix;
# legacy semantics and adblock misses never observe.
# Aggregates are exposed under adblock.shadow_exact in status endpoints.
# SAFE_ZONE_ADBLOCK_SHADOW_EXACT_ENABLED=false

# --- Policy semantics ---
# Controls how an adblock match is reported:
# - separated (default): DNS still blocks, but the adblock reason moves into
#   policy.decision (reason=adblock_match) instead of the verdict. Analyze
#   runs the full independent security pipeline; after group/override lookups
#   (which may touch the store), the Policy post-match fast path scores only
#   with the in-process lexical analyzer against the built-in brand seed
#   (decision.assessment_mode=lexical_local_default_brands) and performs no
#   further backend I/O. Note: telemetry records the security result and
#   source only; policy action/category/assessment_mode are not persisted yet.
#   Cache v2 stores rule digests, but raw source strings can still appear in
#   adblock_meta.json keys and fetch/scan error logs.
# - legacy: emergency rollback; adblock matches are reported as
#   MALICIOUS/100/adware like before the separation.
SAFE_ZONE_POLICY_SEMANTICS=separated
