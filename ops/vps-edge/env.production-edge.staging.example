SAFE_ZONE_ENV=production
SAFE_ZONE_DEPLOYMENT_TIER=production-edge-staging
SAFE_ZONE_PUBLIC_HOST=safe-staging.quorix.io.vn
SAFE_ZONE_CADDY_EMAIL=admin@quorix.io.vn

# Staging uses production behavior with staging-only secrets and hostnames.
# Create these files on the staging host before the first deploy.
SAFE_ZONE_ADMIN_PASSWORD_FILE=./ops/secrets/admin_password
SAFE_ZONE_ADMIN_API_KEY_FILE=./ops/secrets/admin_api_key
# Containers run as the unprivileged `app` user (UID 100 / GID 101 on
# Alpine 3.24). Files created with `umask 077` by the deploy user are
# unreadable there, so fix group ownership once before the first start:
#   sudo chgrp 101 ops/secrets/admin_password ops/secrets/admin_api_key
#   sudo chmod 640 ops/secrets/admin_password ops/secrets/admin_api_key

# Deterministic profile for the first staging deploy.
SAFE_ZONE_AI_PROVIDER=none
SAFE_ZONE_ML_MODE=disabled
SAFE_ZONE_AGENT_ENABLED=false
SAFE_ZONE_AGENT_WHITELIST_ENABLED=false

# DoT is opt-in. With false, port 853 is not published and the port/cert
# smoke scripts skip DoT. To enable it, export a trusted fullchain/privkey
# pair with scripts/ops/export-dot-cert.sh and set this to true before
# deploying through scripts/ops/safe-zone.sh.
SAFE_ZONE_DNS_DOT_ENABLED=false

SAFE_ZONE_REDIS_ADDR=redis:6379
SAFE_ZONE_REDIS_MAXMEMORY=256mb

# Must be the public IPv4 that serves the block page; not a placeholder.
SAFE_ZONE_BLOCK_PAGE_IP=replace-with-staging-vps-public-ip
SAFE_ZONE_BLOCK_PAGE_SUPPORT_EMAIL=security-staging@quorix.io.vn
SAFE_ZONE_DNS_BLOCK_STRATEGY=sinkhole

# At least one source is required in production. core-api exits at startup when
# this list is empty. Keep the daemon list aligned with the core-api preset so
# the feed status page reports the sources that feed-syncd actually syncs.
SAFE_ZONE_THREAT_FEED_SOURCE=https://urlhaus.abuse.ch/downloads/csv_recent/,https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt
SAFE_ZONE_AGENT_FEED_PRESET=production-free
SAFE_ZONE_AGENT_FEED_SOURCES=

# Leave empty when the allow list is DB-only.
SAFE_ZONE_WHITELIST_PATH=

# URL-ML is observer-only. Shadow requires the private bundle and operational
# baseline to be mounted; a missing bundle fails open and never changes a verdict.
SAFE_ZONE_URL_ML_MODE=shadow

SAFE_ZONE_DOCKER_LOG_MAX_SIZE=10m
SAFE_ZONE_DOCKER_LOG_MAX_FILE=5
