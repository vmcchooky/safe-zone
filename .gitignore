# Python sources are TRACKED, not ignored. ml/ and scripts/ hold the model
# training pipeline and the dataset builders that produce data/whitelist and
# data/blacklist; ignoring them by extension made those files invisible to git
# while the docs still referenced them by path. Only interpreter, build and
# test-runner artifacts belong in this section.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
